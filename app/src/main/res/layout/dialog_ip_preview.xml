<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" >

    <TextView
        android:id="@+id/dialog_ip_preview_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textSize="@dimen/dialog_seekbar_message_size" />

    <SurfaceView
        android:id="@+id/dialog_ip_preview_surface"
        android:layout_width="match_parent"
        android:layout_height="200dp" />

    <CheckBox
        android:id="@+id/dialog_ip_preview_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="@string/pref_preview_enabled" />

    <TextView
        android:id="@+id/dialog_ip_preview_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textSize="@dimen/dialog_seekbar_message_size"
        android:visibility="gone" />

</LinearLayout>
